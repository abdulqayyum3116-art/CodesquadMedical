# Copy to .env.local for local development, or set these in your host's
# environment variables for production. Never commit real values.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase service_role (secret) key. Server-only: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard login password
DASHBOARD_PASSWORD=
# Long random string stored in the login cookie (e.g. `openssl rand -hex 32`)
DASHBOARD_SECRET=

# Make.com webhook that receives uploaded video links (server-only)
MAKE_VIDEO_WEBHOOK_URL=

